<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark Theme Colors -->
  <Color x:Key="AppBackgroundColor">#0d1117</Color>
  <Color x:Key="SurfaceColor">#161b22</Color>
  <Color x:Key="SurfaceHoverColor">#21262d</Color>
  <Color x:Key="BorderColor">#30363d</Color>
  <Color x:Key="TextColor">#e6edf3</Color>
  <Color x:Key="TextMutedColor">#7d8590</Color>
  <Color x:Key="TextDimColor">#484f58</Color>
  <Color x:Key="AccentColor">#6366f1</Color>
  <Color x:Key="AccentHoverColor">#818cf8</Color>
  <Color x:Key="AccentFgColor">#ffffff</Color>
  <Color x:Key="SuccessColor">#3fb950</Color>
  <Color x:Key="DangerColor">#f85149</Color>
  <Color x:Key="FooterBgColor">#161b22</Color>
  <Color x:Key="FooterBorderColor">#30363d</Color>
  <Color x:Key="InputBackgroundColor">#0d1117</Color>
  <Color x:Key="InputBorderColor">#30363d</Color>
  <Color x:Key="CheckboxCheckedColor">#6366f1</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
  <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentFgBrush" Color="{StaticResource AccentFgColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="FooterBg" Color="{StaticResource FooterBgColor}"/>
  <SolidColorBrush x:Key="FooterBorder" Color="{StaticResource FooterBorderColor}"/>
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
  <SolidColorBrush x:Key="CheckboxCheckedBrush" Color="{StaticResource CheckboxCheckedColor}"/>
  <SolidColorBrush x:Key="StepDotFuture" Color="#30363d"/>
</ResourceDictionary>
