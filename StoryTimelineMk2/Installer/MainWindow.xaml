<Window x:Class="StoryTimelineInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Story Timeline Setup"
        Width="710" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

  <Grid Margin="15">
    <!-- Shadow border -->
    <Border CornerRadius="12"
            Background="{DynamicResource AppBackground}">
      <Border.Effect>
        <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="22" ShadowDepth="5" Direction="270"/>
      </Border.Effect>
    </Border>

    <!-- Content border (clips to rounded rect) -->
    <Border CornerRadius="12" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="140"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border x:Name="HeaderBorder" Grid.Row="0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#1a0f5e" Offset="0"/>
              <GradientStop Color="#0d0a2e" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>

          <Canvas ClipToBounds="True">
            <!-- Decorative circles -->
            <Ellipse Canvas.Right="-60" Canvas.Bottom="-80"
                     Width="220" Height="220"
                     Stroke="#0cffffff"
                     StrokeThickness="1.5"/>
            <Ellipse Canvas.Right="60" Canvas.Top="-40"
                     Width="120" Height="120"
                     Stroke="#08ffffff"
                     StrokeThickness="1"/>

            <!-- App icon + title (absolute-positioned row) -->
            <StackPanel Canvas.Left="36" Canvas.Top="36"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
              <!-- Icon circle -->
              <Viewbox Width="44" Height="44" Margin="0,0,16,0">
                <Canvas Width="48" Height="48">
                  <Ellipse Width="48" Height="48" Fill="#6366f1"/>
                  <!-- Axis line -->
                  <Line X1="8" Y1="28" X2="40" Y2="28"
                        Stroke="White" StrokeThickness="1.5"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <!-- Ticks -->
                  <Line X1="14" Y1="24" X2="14" Y2="32"
                        Stroke="White" StrokeThickness="1.5"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <Line X1="24" Y1="24" X2="24" Y2="32"
                        Stroke="White" StrokeThickness="1.5"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <Line X1="34" Y1="24" X2="34" Y2="32"
                        Stroke="White" StrokeThickness="1.5"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <!-- Event box -->
                  <Border Canvas.Left="18" Canvas.Top="14"
                          Width="14" Height="8"
                          Background="White"
                          CornerRadius="2"/>
                  <!-- Stem -->
                  <Line X1="25" Y1="22" X2="25" Y2="28"
                        Stroke="White" StrokeThickness="1.5"/>
                </Canvas>
              </Viewbox>

              <!-- Title stack -->
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Story Timeline"
                           Foreground="White"
                           FontFamily="Segoe UI Light"
                           FontSize="26"
                           FontWeight="Light"/>
                <TextBlock x:Name="SubtitleBlock"
                           Text="v1.0.0 — Setup"
                           Foreground="#a5b4fc"
                           FontSize="12"/>
              </StackPanel>
            </StackPanel>

            <!-- Chrome buttons -->
            <StackPanel Canvas.Right="8" Canvas.Top="8"
                        Orientation="Horizontal">
              <Button x:Name="MinimizeButton"
                      Style="{StaticResource ChromeButton}"
                      Content="&#x2013;"
                      Click="MinimizeButton_Click"
                      ToolTip="Minimize"/>
              <Button x:Name="CloseButton"
                      Style="{StaticResource CloseButton}"
                      Content="&#x2715;"
                      Click="CloseButton_Click"
                      ToolTip="Close"/>
            </StackPanel>
          </Canvas>
        </Border>

        <!-- ===== CONTENT ===== -->
        <ContentControl x:Name="MainContent"
                        Grid.Row="1"
                        Background="{DynamicResource AppBackground}"
                        BorderThickness="0"/>

        <!-- ===== FOOTER ===== -->
        <Border Grid.Row="2"
                Background="{DynamicResource FooterBg}"
                BorderBrush="{DynamicResource FooterBorder}"
                BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Step dots -->
            <StackPanel x:Name="StepDots"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="24,0,0,0"/>

            <!-- Navigation buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
              <Button x:Name="BackButton"
                      Style="{StaticResource SecondaryButton}"
                      Content="&#x2190; Back"
                      Margin="0,0,10,0"
                      Click="BackButton_Click"/>
              <Button x:Name="NextButton"
                      Style="{StaticResource PrimaryButton}"
                      Content="Next &#x2192;"
                      Click="NextButton_Click"/>
            </StackPanel>
          </Grid>
        </Border>

      </Grid>
    </Border>
  </Grid>
</Window>
