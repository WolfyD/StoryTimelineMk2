<UserControl x:Class="StoryTimelineInstaller.Pages.LicensePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="{DynamicResource AppBackground}">
  <Grid Margin="36,28,36,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Style="{StaticResource PageTitle}"
               Text="License Agreement"/>

    <TextBlock Grid.Row="1"
               Style="{StaticResource PageSubtitle}"
               Text="Please read the following license agreement before installing Story Timeline."/>

    <Border Grid.Row="2"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{DynamicResource SurfaceBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="2,0">
        <TextBox x:Name="LicenseTextBox"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 FontFamily="Consolas,Courier New"
                 FontSize="11.5"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="14,12"
                 CaretBrush="Transparent"
                 SelectionBrush="{DynamicResource AccentBrush}"
                 FocusVisualStyle="{x:Null}"/>
      </ScrollViewer>
    </Border>

    <CheckBox x:Name="AgreeCheckBox"
              Grid.Row="3"
              Style="{StaticResource AppCheckBox}"
              Content="I accept the terms of the license agreement"
              Margin="0,14,0,0"
              Checked="AgreeCheckBox_Toggled"
              Unchecked="AgreeCheckBox_Toggled"/>
  </Grid>
</UserControl>
