<UserControl x:Class="StoryTimelineInstaller.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="{DynamicResource AppBackground}">
  <StackPanel Margin="36,28,36,0">

    <TextBlock x:Name="TitleBlock"
               Style="{StaticResource PageTitle}"
               Text="Welcome to Story Timeline"/>

    <TextBlock x:Name="SubtitleBlock"
               Style="{StaticResource PageSubtitle}"
               Text="This wizard will install Story Timeline v1.0.0 on your computer."/>

    <!-- Info box -->
    <Border CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="16"
            Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="The following will be installed:"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="&#x2713;" Foreground="{DynamicResource SuccessBrush}"
                     FontWeight="Bold" Margin="0,0,10,0"/>
          <TextBlock Text="Story Timeline application"
                     Foreground="{DynamicResource TextBrush}" FontSize="13"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="&#x2713;" Foreground="{DynamicResource SuccessBrush}"
                     FontWeight="Bold" Margin="0,0,10,0"/>
          <TextBlock Text="Start Menu shortcut"
                     Foreground="{DynamicResource TextBrush}" FontSize="13"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#x2713;" Foreground="{DynamicResource SuccessBrush}"
                     FontWeight="Bold" Margin="0,0,10,0"/>
          <TextBlock Text="Desktop shortcut (optional)"
                     Foreground="{DynamicResource TextBrush}" FontSize="13"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Text="By proceeding you agree to use this software for personal creative projects."
               Foreground="{DynamicResource TextDimBrush}"
               FontSize="11"
               TextWrapping="Wrap"/>

  </StackPanel>
</UserControl>
