<UserControl x:Class="StoryTimelineInstaller.Pages.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}">
  <StackPanel Margin="36,28,36,0">

    <TextBlock x:Name="ProgressTitle"
               Style="{StaticResource PageTitle}"
               Text="Installing Story Timeline..."/>

    <ProgressBar x:Name="ProgressBar"
                 Style="{StaticResource AppProgressBar}"
                 Value="0"
                 Maximum="100"
                 Height="8"
                 Margin="0,0,0,16"/>

    <TextBlock x:Name="StatusLabel"
               Foreground="{DynamicResource TextMutedBrush}"
               FontSize="13"
               TextWrapping="Wrap"
               Margin="0,0,0,16"
               Text="Preparing..."/>

    <Border CornerRadius="6"
            Background="{DynamicResource SurfaceHoverBrush}"
            Padding="10"
            MaxHeight="160">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="LogBox"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="{DynamicResource TextMutedBrush}"
                 FontFamily="Consolas"
                 FontSize="11"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Disabled"/>
      </ScrollViewer>
    </Border>

  </StackPanel>
</UserControl>
