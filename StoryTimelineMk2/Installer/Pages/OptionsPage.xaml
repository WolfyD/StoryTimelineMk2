<UserControl x:Class="StoryTimelineInstaller.Pages.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="{DynamicResource AppBackground}">
  <StackPanel Margin="36,28,36,0">

    <TextBlock Style="{StaticResource PageTitle}"
               Text="Installation Options"/>

    <TextBlock Style="{StaticResource PageSubtitle}"
               Text="Customise your installation."/>

    <CheckBox x:Name="DesktopCb"
              Style="{StaticResource AppCheckBox}"
              Content="Create a desktop shortcut"
              IsChecked="True"
              Margin="0,0,0,14"
              Checked="DesktopCb_Checked"
              Unchecked="DesktopCb_Unchecked"/>

    <CheckBox x:Name="StartMenuCb"
              Style="{StaticResource AppCheckBox}"
              Content="Create a Start Menu shortcut"
              IsChecked="True"
              Margin="0,0,0,14"
              Checked="StartMenuCb_Checked"
              Unchecked="StartMenuCb_Unchecked"/>

    <CheckBox x:Name="LaunchCb"
              Style="{StaticResource AppCheckBox}"
              Content="Launch Story Timeline after installation"
              IsChecked="True"
              Margin="0,0,0,24"
              Checked="LaunchCb_Checked"
              Unchecked="LaunchCb_Unchecked"/>

    <TextBlock Style="{StaticResource FieldLabel}"
               Text="INSTALLATION SUMMARY"/>

    <Border CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="Install to:" Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" Width="80"/>
          <TextBlock x:Name="SummaryPath"
                     Foreground="{DynamicResource TextBrush}"
                     FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Space needed:" Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" Width="80"/>
          <TextBlock Text="~50 MB" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
        </StackPanel>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
