<UserControl x:Class="StoryTimelineInstaller.Pages.ModePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="{DynamicResource AppBackground}">
  <StackPanel Margin="36,28,36,0">

    <TextBlock Style="{StaticResource PageTitle}"
               Text="Story Timeline is Already Installed"/>

    <TextBlock x:Name="SubtitleBlock"
               Style="{StaticResource PageSubtitle}"/>

    <RadioButton x:Name="InstallRadio"
                 Style="{StaticResource OptionRadioButton}"
                 GroupName="ModeGroup"
                 IsChecked="True">
      <StackPanel>
        <TextBlock x:Name="InstallLabel"
                   FontFamily="Segoe UI"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="0,0,0,4"/>
        <TextBlock x:Name="InstallDesc"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </RadioButton>

    <RadioButton x:Name="UninstallRadio"
                 Style="{StaticResource OptionRadioButton}"
                 GroupName="ModeGroup">
      <StackPanel>
        <TextBlock FontFamily="Segoe UI"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"
                   Text="Uninstall Story Timeline"
                   Margin="0,0,0,4"/>
        <TextBlock FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="Remove Story Timeline and all shortcuts from your computer."
                   TextWrapping="Wrap"/>
      </StackPanel>
    </RadioButton>

  </StackPanel>
</UserControl>
