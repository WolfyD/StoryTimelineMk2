<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StoryTimelineInstaller</AssemblyName>
    <RootNamespace>StoryTimelineInstaller</RootNamespace>
    <Product>Story Timeline Installer</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\Misc\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Suppress WinForms DPI warning — DPI is configured via WPF manifest (correct for WPF apps) -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
</Project>
