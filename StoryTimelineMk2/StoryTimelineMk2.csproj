<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Misc\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WebView2 WPF shim targets net5.0-windows; WinForms project doesn't use WPF so the conflict is irrelevant -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- DPI awareness is declared in app.manifest (needed alongside UAC settings); suppress the redundancy warning -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>StoryTimeline</AssemblyName>
    <RootNamespace>StoryTimelineMk2</RootNamespace>
    <Product>Story Timeline</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <!-- Pin transitive SQLite native lib to patched version (fixes GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StoryTimelineMk2.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <Folder Include="Frontend\src\components\" />
    <Folder Include="Frontend\src\bridge\" />
    <Folder Include="Frontend\src\assets\" />
    <Folder Include="Frontend\src\stores\" />
    <Folder Include="Frontend\src\pages\" />
  </ItemGroup>

  <!-- Build the Vue SPA and copy its output next to the exe on every dotnet publish -->
  <Target Name="PublishFrontend" AfterTargets="Publish">
    <Message Text="[PublishFrontend] Building Vue frontend..." Importance="high" />
    <Exec Command="npm run build-only" WorkingDirectory="$(MSBuildProjectDirectory)\Frontend" />
    <ItemGroup>
      <FrontendDistFiles Include="$(MSBuildProjectDirectory)\Frontend\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendDistFiles)" DestinationFiles="@(FrontendDistFiles->'$(PublishDir)Frontend\dist\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Text="[PublishFrontend] Copied dist ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ $(PublishDir)Frontend\dist\" Importance="high" />
  </Target>

  <ItemGroup>
    <Content Remove="Frontend\**" />
    <Compile Remove="Frontend\**" />
    <EmbeddedResource Remove="Frontend\**" />
    <None Remove="Frontend\**" />
    <Content Remove="StoryTimelineMk2.Tests\**" />
    <Compile Remove="StoryTimelineMk2.Tests\**" />
    <EmbeddedResource Remove="StoryTimelineMk2.Tests\**" />
    <None Remove="StoryTimelineMk2.Tests\**" />
    <Content Remove="Installer\**" />
    <Compile Remove="Installer\**" />
    <EmbeddedResource Remove="Installer\**" />
    <None Remove="Installer\**" />
    <Page Remove="Installer\**" />
    <Content Remove="StoryTimelineInstaller.Tests\**" />
    <Compile Remove="StoryTimelineInstaller.Tests\**" />
    <EmbeddedResource Remove="StoryTimelineInstaller.Tests\**" />
    <None Remove="StoryTimelineInstaller.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>